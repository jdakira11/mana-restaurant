# ─────────────────────────────────────────────────────────────────────────────
# Maná · variables de entorno. Copia este fichero a .env.local (desarrollo) o
# configúralas en tu proveedor de hosting. NUNCA subas ficheros .env al repositorio.
# Solo las variables con prefijo NEXT_PUBLIC_ llegan al navegador: jamás pongas
# secretos con ese prefijo.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública definitiva (canónicas, sitemap, enlaces de los correos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# Sin DATABASE_URL se usa PGlite (Postgres embebido) en .data/pglite: solo desarrollo.
# Supabase: Project Settings → Database → Connection string (URI). En entornos
# serverless usa el "Transaction pooler" (puerto 6543).
DATABASE_URL=
# require (por defecto, verifica certificado) | no-verify | disable
DATABASE_SSL=require
# Certificado CA en PEM (con \n) si tu proveedor lo requiere, p. ej. el de Supabase
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5
# Permite PGlite en producción (solo en un servidor propio con disco persistente)
ALLOW_EMBEDDED_DB=false
# PGLITE_DATA_DIR=.data/pglite

# ── Panel de administración ─────────────────────────────────────────────────
ADMIN_EMAIL=
# Genera el valor con:  npm run admin:hash -- "contraseña-larga-y-única"
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de 32+ caracteres (la genera también admin:hash)
SESSION_SECRET=
# Sal para anonimizar IPs en el control de abusos (opcional; por defecto SESSION_SECRET)
IP_HASH_SALT=

# ── Correo transaccional (Resend · https://resend.com) ──────────────────────
# Si falta, las reservas funcionan pero NO se envía ningún correo (queda registrado en el panel).
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, p. ej.  Maná <reservas@tudominio.com>
EMAIL_FROM=
# Buzón del restaurante que recibe los avisos de nuevas reservas
RESTAURANT_NOTIFICATION_EMAIL=

# ── Anti-bots opcional (Cloudflare Turnstile) ────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Generación de imágenes con IA (NO usada actualmente) ─────────────────────
# Integración futura documentada en docs/IMAGENES.md. Clave SOLO de servidor.
# OPENAI_API_KEY=
